# Plantilla para Settings > Environment Variables de Vercel.
# NO importar el .env local ni copiar las variables de Docker o seed.
# Sustituye los ejemplos; no son credenciales reales.
DATABASE_URL="postgresql://USER:PASSWORD@POOL_HOST:5432/DATABASE?sslmode=require"
# Opcional: conexión directa para migraciones si tu proveedor la requiere.
DIRECT_URL=""
BETTER_AUTH_SECRET="REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_64_CARACTERES"
BETTER_AUTH_URL="https://TU-PROYECTO.vercel.app"
NEXT_PUBLIC_APP_URL="https://TU-PROYECTO.vercel.app"
BETTER_AUTH_TRUSTED_ORIGINS="https://TU-PROYECTO.vercel.app"
TRUSTED_PROXY_HEADER="x-forwarded-for"
TRUSTED_PROXY_IPS=""
EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_REEMPLAZAR"
EMAIL_FROM="TaxiFlash <reservas@TU-DOMINIO-VERIFICADO.com>"
TARIFA_BASE="2.50"
TARIFA_POR_KM="1.20"
TARIFA_MINIMA="4.00"
# Mantener true para la presentación al cliente, incluso en Production.
SITE_NOINDEX="true"
# Google OAuth es opcional. Debes configurar ambas variables juntas.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
# Solo si eliges EMAIL_PROVIDER=smtp: proveedor remoto, nunca Mailpit/local.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# TaxiFlash — configuración local de desarrollo.
# Copia este archivo como .env. Nunca publiques ni confirmes .env en Git.

# PostgreSQL de docker-compose se expone solo en localhost:5433.
DATABASE_URL="postgresql://taxiflash:taxiflash_dev_password@localhost:5433/taxiflash"
POSTGRES_USER="taxiflash"
POSTGRES_PASSWORD="taxiflash_dev_password"
POSTGRES_DB="taxiflash"

# Genera uno distinto para cada entorno: openssl rand -hex 32
BETTER_AUTH_SECRET="cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres"
BETTER_AUTH_URL="http://localhost:3500"
NEXT_PUBLIC_APP_URL="http://localhost:3500"

# Solo confíes en esta cabecera si el origen no es accesible directamente y tu
# proxy/CDN la sobrescribe. Ejemplos: x-real-ip (nginx), cf-connecting-ip.
TRUSTED_PROXY_HEADER="x-real-ip"

# OAuth de Google (opcional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Correo: usa "resend" en pruebas remotas o "smtp" con Mailpit/local.
EMAIL_PROVIDER="smtp"
RESEND_API_KEY=""
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_FROM="TaxiFlash <no-reply@taxiflash.local>"

TARIFA_BASE="2.50"
TARIFA_POR_KM="1.20"
TARIFA_MINIMA="4.00"
SEED_ADMIN_EMAIL="admin@taxiflash.local"
# Exclusivo para desarrollo. En producción no ejecutes el servicio migrate/seed.
SEED_ADMIN_PASSWORD="Admin123!"

# Copia este archivo a .env y ajusta los valores.

# --- Base de datos ---
# En desarrollo local (docker compose up db): puerto 5433 del host.
# Dentro de docker compose (app): postgresql://taxiflash:<POSTGRES_PASSWORD>@db:5432/taxiflash
DATABASE_URL="postgresql://taxiflash:taxiflash_dev_password@localhost:5433/taxiflash"

# Credenciales del contenedor de Postgres (docker-compose)
POSTGRES_USER="taxiflash"
POSTGRES_PASSWORD="taxiflash_dev_password"
POSTGRES_DB="taxiflash"

# --- better-auth ---
# Genera un secreto fuerte: openssl rand -hex 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3500"
NEXT_PUBLIC_APP_URL="http://localhost:3500"

# --- OAuth Google (opcional: si faltan, el login con Google queda deshabilitado) ---
# https://console.cloud.google.com/apis/credentials
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (SMTP via Nodemailer) ---
# ¿AÚN NO TIENES SERVICIO DE CORREO? Deja SMTP_HOST vacío: no se enviará
# ningún email y todo lo demás funciona normal (notificaciones in-app, flujos…).
# Para PROBAR correos en local: docker-compose levanta Mailpit
#   -> SMTP_HOST="localhost", SMTP_PORT="1025"; los correos se ven en http://localhost:8025
# En producción: apunta estas variables a tu proveedor SMTP real.
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_FROM="TaxiFlash <no-reply@taxiflash.local>"

# --- Tarifas (estimación mostrada al cliente; el cobro real es por taxímetro) ---
TARIFA_BASE="2.50"
TARIFA_POR_KM="1.20"
TARIFA_MINIMA="4.00"

# --- Seed inicial (cuenta admin creada por prisma/seed.ts) ---
SEED_ADMIN_EMAIL="admin@taxiflash.local"
SEED_ADMIN_PASSWORD="Admin123!"
